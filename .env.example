# Copy to .env. Never commit real values.
# The provider variables below match config/providers.example.json.

AUTORESEARCH_CONFIG=./config/providers.local.json
AUTORESEARCH_DATA_DIR=./data
AUTORESEARCH_LOG_DIR=./logs
AUTORESEARCH_OUTPUT_DIR=./outputs

# Endpoint URLs and credentials. Fill only the routes you use.
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
GEMINI_BASE_URL=
GEMINI_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_BASE=
OPENAI_API_KEY=
GPT_CRITIC_BASE_URL=
GPT_CRITIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Optional wire-model overrides referenced by the tracked routes.
ANTHROPIC_MODEL=
GEMINI_REVIEW_MODEL=
GPT_CRITIC_MODEL=
OPENAI_MODEL=
OPENAI_SMALL_MODEL=
OPENAI_MID_MODEL=
OPENAI_LARGE_MODEL=

# A custom providers.local.json may use its own names, for example
# MY_GATEWAY_URL= and MY_GATEWAY_KEY=.

# Optional one-process role overrides. Prefer editing roles in the JSON for normal use.
AR_MODEL_SCREENER=
AR_MODEL_JUDGE=
AR_MODEL_CONSENSUS_CHECKER=
AR_MODEL_IDEATOR=
AR_MODEL_PLANNER=
AR_MODEL_FRESHNESS_REFRESHER=
AR_MODEL_AGENT=
AR_MODEL_CODE_REVIEWER=
AR_MODEL_CRITIC=
AR_MODEL_CRITIC_SECONDARY=

# Optional search and network settings.
TAVILY_API_KEY=
AUTORESEARCH_PROXY_URL=
AR_LLM_TIMEOUT=900
